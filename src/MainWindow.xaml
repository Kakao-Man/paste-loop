<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteLoop" Width="600" Height="790" MinWidth="560" MinHeight="750"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#202824"/>
    <SolidColorBrush x:Key="Muted" Color="#69746E"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8E3"/>
    <SolidColorBrush x:Key="Input" Color="#F7F9F7"/>
    <SolidColorBrush x:Key="Accent" Color="#237854"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F3EC"/>
    <SolidColorBrush x:Key="Danger" Color="#B5473B"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="SwitchStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Padding="3"
                  Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Ellipse x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Thumb" Property="Fill" Value="White"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  </Window.Resources>
  <Grid Margin="30,25,30,20" Background="{DynamicResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
      <RowDefinition Height="*"/><RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="PasteLoop" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Your text. On repeat." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Top" Margin="10,5,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="LightButton" Content="Light" FontSize="12" Padding="10,7" BorderThickness="0" AutomationProperties.Name="Light theme"/>
          <Button x:Name="DarkButton" Content="Dark" FontSize="12" Padding="10,7" BorderThickness="0" AutomationProperties.Name="Dark theme"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" CornerRadius="14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22,18,22,16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="Text to paste" FontWeight="SemiBold"/>
          <TextBlock Text="01" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid>
        <Border Grid.Row="2" Background="{DynamicResource Input}" CornerRadius="9" Padding="13,11" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid>
            <TextBox x:Name="PasteText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" AutomationProperties.Name="Text to paste repeatedly"/>
            <TextBlock x:Name="Placeholder" Text="For example, Earthworm..." Foreground="{DynamicResource Muted}" FontSize="17" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <TextBlock Text="Copied to clipboard when you start." FontSize="11" Foreground="{DynamicResource Muted}"/>
          <TextBlock x:Name="CharacterCount" Text="0 characters" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="4" CornerRadius="14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22,18">
      <StackPanel>
        <Grid><TextBlock Text="Pasting speed" FontWeight="SemiBold"/>
          <TextBlock Text="02" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Time between pastes" FontSize="12"/>
            <TextBlock Text="From 0.1 to 60 seconds" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="MinusButton" Content="−" Padding="9,4" FontSize="18" BorderThickness="0" ToolTip="Decrease interval"/>
              <TextBox x:Name="IntervalText" Text="1.0" Width="55" FontSize="17" TextAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Interval in seconds"/>
              <TextBlock Text="s" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
              <Button x:Name="PlusButton" Content="+" Padding="9,4" FontSize="18" BorderThickness="0" ToolTip="Increase interval"/>
            </StackPanel>
          </Border>
        </Grid>
        <UniformGrid Columns="4" Margin="0,14,0,0">
          <Button x:Name="PresetFast" Content="0.1 s" Tag="0.1" Margin="0,0,6,0" Padding="8,7" FontSize="12"/>
          <Button x:Name="PresetHalf" Content="0.5 s" Tag="0.5" Margin="2,0,4,0" Padding="8,7" FontSize="12"/>
          <Button x:Name="PresetNormal" Content="1 s" Tag="1" Margin="4,0,2,0" Padding="8,7" FontSize="12"/>
          <Button x:Name="PresetSlow" Content="2 s" Tag="2" Margin="6,0,0,0" Padding="8,7" FontSize="12"/>
        </UniformGrid>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Enter after pasting" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="Press Enter after every paste." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock x:Name="EnterState" Text="Off" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <CheckBox x:Name="EnterToggle" IsChecked="False" Style="{StaticResource SwitchStyle}"
                        AutomationProperties.Name="Enter after pasting" ToolTip="Turn Enter after each Ctrl+V on or off"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusTitle" Text="Ready" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock x:Name="StatusDetail" Text="You have 3 seconds to switch to another window." Foreground="{DynamicResource Muted}" FontSize="12" Margin="15,5,0,0" TextWrapping="Wrap" MaxWidth="390" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
        <TextBlock x:Name="PasteCount" Text="0" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <TextBlock Text="pasted" FontSize="11" Foreground="{DynamicResource Muted}"/>
      </StackPanel>
    </Grid>
    <Button Grid.Row="8" x:Name="StartButton" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Padding="20,15" FontSize="15" FontWeight="SemiBold" Content="Start pasting"/>
    <Grid Grid.Row="10">
      <TextBlock x:Name="HotkeyHint" Text="F6  start / stop" Foreground="{DynamicResource Muted}" FontSize="11"/>
      <TextBlock Text="F8  stop immediately" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Window>
